<?xml version="1.0" encoding="utf-8"?>
<!--
  Round adaptive launcher icon (Android 8.0+).

  Same two layers as ic_launcher.xml, generated from the uploaded master image
  public/logo-source.png by scripts/build-icons.sh. Launchers that ask for a
  round icon mask this themselves; the artwork stays inside the safe zone.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_stat_rifq" />
</adaptive-icon>
