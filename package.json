  "devDependencies": {
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "^5.6.3",
    "vite": "^8.3.8"
  }
