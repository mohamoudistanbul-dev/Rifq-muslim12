  "dependencies": {
    "adhan": "^4.4.3",
    "express": "^5.3.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.6",
    "sql.js": "^1.17.0",
    "tz-lookup": "^6.1.25",
    "web-push": "^4.0.0"
