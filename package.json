{
  "name": "rifq-muslim",
  "version": "1.0.0",
  "private": true,
  "description": "RIFQ Muslim - Your Faith, Your Daily Companion. Made by Eng Mohamud Yusuf.",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start": "node server/index.js",
    "typecheck": "tsc --noEmit",
