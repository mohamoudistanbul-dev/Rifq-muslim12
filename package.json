    "verify:admin": "node scripts/verify-admin.mjs",
    "verify:download": "node scripts/verify-download.mjs",
    "verify:notify": "tsx scripts/verify-notify.ts",
    "geo:build": "node scripts/build-geo-data.mjs",
    "verify:touch": "node scripts/verify-text-selection.mjs",
    "verify:invite": "tsx scripts/verify-invite.ts",
    "verify:settings": "node scripts/verify-settings-persistence.mjs",
    "verify:workflow": "node scripts/validate-android-workflow.mjs",
    "verify:analytics": "node scripts/verify-analytics.mjs",
    "verify:geo": "tsx scripts/verify-geo.ts",
